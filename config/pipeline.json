{
  "version": 2,
  "task_workers": 1,
  "api_max_concurrency": 1,
  "api_limit_scope": "model",
  "max_agent_turns": 250,
  "plan_max_turns": 20,
  "initial_build_retries": 3,
  "repair_rounds": 3,
  "allowed_reference_formats": [],
  "required_deliverable_formats": [],
  "reference_file_count": null,
  "external_retrieval": true,
  "source_cases": "data/source_pools/cases.json",
  "stage_models": {},
  "runtime": {
    "node": "",
    "python": "",
    "docx_renderer": "",
    "pptx_finalizer": ""
  },
  "sandbox": {
    "backend": "docker",
    "image": "workfactory/runtime:v2",
    "memory": "2g",
    "cpus": 1,
    "command_timeout_seconds": 120
  },
  "retrieval": {
    "backend": "responses_web_search",
    "candidate_attempts": 3
  },
  "skill_discovery": {
    "enabled": true,
    "cli": "skills",
    "cli_version": "1.8.1",
    "initial_queries": 3,
    "per_query": 5,
    "initial_candidates": 15,
    "extra_candidates": 10,
    "max_research_rounds": 2,
    "max_candidates": 35,
    "min_selected": 2,
    "max_selected": 4,
    "min_operations": 6,
    "min_chain_depth": 4,
    "cache_dir": "data/skills_discovery_cache",
    "cache_ttl_seconds": 86400,
    "request_timeout": 60
  }
}
